    "FastFLUX2Klein": {
      "url": null,
      "model": "flux2klein",
      "token_env": null,
      "timeout_seconds": 180
    },
    "FastSAM3": {
      "url": null,
      "model": "sam3",
      "token_env": null,
      "timeout_seconds": 60
    },
    "FastDA3": {
      "url": null,
      "model": "da3",
      "token_env": null,
      "timeout_seconds": 180
    },
    "FastTrellis2": {
      "url": null,
      "model": "fasttrellis2",
      "token_env": null,
      "timeout_seconds": 1800
    },
    "IssacSim4A100": {
      "mode": "grpc",
      "grpc": {
        "host": null,
        "port": 50051,
        "timeout_seconds": 60
      },
      "capture_timeout_seconds": 1800
    }
  }
