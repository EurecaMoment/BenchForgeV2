{
  "config_version": 4,
  "dsh": {
    "repository": "https://github.com/EurecaMoment/deepseek-harness4BenchForge.git",
    "path": "third_party/deepseek-harness4BenchForge",
    "version": "0.2.2-rc.3",
    "node": ">=24.9.0",
    "package_manager": "pnpm@11.28.5"
  },
  "web": {
    "port": 3081,
    "default_workspace": null
  },
  "server": {
    "port": 3841,
    "execution_mode": "production"
  },
  "database": {
    "project": "benchforge",
