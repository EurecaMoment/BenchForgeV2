        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "choice_semantics": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Choice Semantics",
      "type": "object"
    }
