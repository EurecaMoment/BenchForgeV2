{
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "benchclaw/v1",
      "default": "benchclaw/v1",
      "title": "Contract Version",
      "type": "string"
    },
    "producer": {
      "default": "benchclaw",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "file_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "File Id",
      "type": "string"
    },
    "uri": {
      "minLength": 1,
      "title": "Uri",
      "type": "string"
    },
    "kind": {
      "enum": [
        "depth",
        "mask",
        "pose",
        "action",
        "state",
        "pointcloud",
        "metadata",
        "usage"
      ],
      "title": "Kind",
      "type": "string"
    },
    "byte_size": {
      "exclusiveMinimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "source_uri": {
      "minLength": 1,
      "title": "Source Uri",
      "type": "string"
    },
    "original_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Uri"
    }
  },
  "required": [
    "file_id",
    "uri",
    "kind",
    "byte_size",
    "source_uri"
  ],
  "title": "DataFile",
  "type": "object"
}
