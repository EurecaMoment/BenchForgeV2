{
  "name": "@eurecamoment/benchforge-dsh",
  "version": "0.2.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "BenchForge and BenchForge_UI presets for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/EurecaMoment/BenchForgeV2.git",
    "directory": "src/dsh"
  },
  "engines": { "node": ">=24.9.0" },
  "exports": {
    ".": "./presets/tools.mjs",
    "./benchforge-tools": "./presets/tools.mjs",
    "./benchforge-scene-tools": "./plugin/tools.mjs",
    "./benchforge-ui": "./ui/index.js",
    "./persistent-shell": "./presets/persistent-shell.mjs",
    "./tool-executor": "./presets/tool_executor.mjs",
    "./subagent-policy": "./presets/subagent_policy.mjs",
    "./preset-aliases": "./presets/preset_aliases.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:benchforge-ui": "node ./ui/build_client.mjs",
    "prepack": "node ./stage_package.mjs"
  },
  "files": [
    "presets/*.mjs",
    "presets/*.py",
    "plugin/*.mjs",
    "shared/*.mjs",
    "benchforge/capture_finish.py",
    "maintenance/repair_scene_library.py",
    "check_config.py",
    "task_support/*.py",
    "task_support/native_asset_facing.json",
    "task_support/README.md",
    "ui/DESIGN.md",
    "ui/*.js",
    "ui/*.mjs",
    "ui/*.py",
    "ui/client/**/*.js",
    "ui/workbench/**/*.js",
    "dist/resources/*.json",
    "dist/workbench/*.py",
    "ui/package.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-web-app": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.3",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-web-app": "0.2.2-rc.3",
    "esbuild": "0.25.12"
  }
}
