{
  "name": "@eurecamoment/benchforge-dsh",
  "version": "0.2.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "BenchForge and BenchForge_UI presets for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/EurecaMoment/BenchForgeV2.git",
    "directory": "integrations"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "exports": {
    ".": "./dsh/tools.mjs",
    "./benchforge-tools": "./dsh/tools.mjs",
    "./benchforge-scene-tools": "./benchforge/plugin/tools.mjs",
    "./benchforge-ui": "./benchforge/ui/index.js",
    "./persistent-shell": "./dsh/persistent-shell.mjs",
    "./preset-aliases": "./dsh/preset_aliases.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:benchforge-ui": "node ./benchforge/ui/build_client.mjs",
    "prepack": "node ./stage_package.mjs"
  },
  "files": [
    "dsh/*.mjs",
    "dsh/build_preset.py",
    "dsh/build_presets.py",
    "dsh/profile_migration.py",
    "dsh/install_preset.py",
    "dsh/hot_update.py",
    "dsh/install_workbench.py",
    "dsh/preset_definition.py",
    "benchforge/plugin/*.mjs",
    "benchforge/shared/*.mjs",
    "benchforge/scene_policy_gate.py",
    "benchforge/capture_retry.py",
    "benchforge/capture_finish.py",
    "benchforge/native_asset_facing.py",
    "benchforge/native_asset_facing.json",
    "benchforge/maintenance/repair_scene_library.py",
    "benchforge/repair_scene_library.py",
    "benchforge/build_preset.py",
    "benchforge/check_config.py",
    "benchforge/build_development_preset.py",
    "benchforge/task_support/*.py",
    "benchforge/task_support/README.md",
    "benchforge/ui/DESIGN.md",
    "benchforge/hot_update.py",
    "benchforge/install_workbench.py",
    "benchforge/ui/*.js",
    "benchforge/ui/*.mjs",
    "benchforge/ui/*.py",
    "benchforge/ui/client/**/*.js",
    "benchforge/ui/workbench/**/*.js",
    "dist/resources/*.json",
    "dist/dispatcher/capture_finish.py",
    "dist/workbench/workbench_queries.py",
    "benchforge/ui/package.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-web-app": "0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-web-app": "0.1.7-rc.1",
    "esbuild": "0.25.12"
  }
}
