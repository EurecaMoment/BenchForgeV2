{
  "name": "@eurecamoment/benchforge-dsh",
  "version": "0.2.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "BenchForge, BenchForgeV2 and BenchForgeV2_UI presets for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/EurecaMoment/BenchForgeV2.git",
    "directory": "integrations"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "exports": {
    ".": "./dsh/tools.mjs",
    "./benchforge-tools": "./dsh/tools.mjs",
    "./spatialforge-tools": "./spatialforge/plugin/tools.mjs",
    "./spatialforge-ui": "./spatialforge/ui/index.js",
    "./persistent-shell": "./dsh/persistent-shell.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:spatialforge-ui": "node ./spatialforge/ui/build_client.mjs"
  },
  "files": [
    "dsh/*.mjs",
    "dsh/build_preset.py",
    "dsh/build_presets.py",
    "dsh/profile_migration.py",
    "dsh/install_preset.py",
    "spatialforge/plugin/*.mjs",
    "spatialforge/shared/*.mjs",
    "spatialforge/scene_policy_gate.py",
    "spatialforge/capture_retry.py",
    "spatialforge/capture_finish.py",
    "spatialforge/native_asset_facing.py",
    "spatialforge/native_asset_facing.json",
    "spatialforge/repair_scene_library.py",
    "spatialforge/build_preset.py",
    "spatialforge/check_config.py",
    "spatialforge/build_development_preset.py",
    "spatialforge/preset_definition.py",
    "spatialforge/task_support/*.py",
    "spatialforge/task_support/README.md",
    "spatialforge/ui/DESIGN.md",
    "spatialforge/hot_update.py",
    "spatialforge/install_workbench.py",
    "spatialforge/ui/*.js",
    "spatialforge/ui/*.mjs",
    "spatialforge/ui/*.py",
    "spatialforge/ui/client/**/*.js",
    "spatialforge/ui/workbench/**/*.js",
    "resources/*.json",
    "spatialforge/ui/package.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-web-app": "0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-web-app": "0.1.7-rc.1",
    "esbuild": "0.25.12"
  }
}
